# Copia este archivo como ".env" y pega tu clave de Anthropic (https://console.anthropic.com).
# Con la clave obtienes: gancho al inicio, capítulos con título, títulos, descripción y etiquetas.
# Sin clave el editor funciona igual, pero sin esas partes.
ANTHROPIC_API_KEY=

# Modelo de Claude (opcional)
YT_EDITOR_MODEL=claude-opus-5-5
